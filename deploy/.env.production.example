# Copy to .env on the VM (cp deploy/.env.production.example .env) and fill in every value.

# --- required ---
LLM_API_KEY=            # a NEW Groq key just for production
METRICS_TOKEN=          # long random string, e.g. output of: openssl rand -hex 24
POSTGRES_PASSWORD=      # long random string
DOMAIN=                 # your DuckDNS name, e.g. mochi-cafe.duckdns.org
PROXY_SECRET=           # long random string; the SAME value goes into the website's PROXY_SECRET setting

# --- DuckDNS (keeps the name pointing at this VM) ---
DUCKDNS_SUBDOMAIN=      # just the name part, e.g. mochi-cafe
DUCKDNS_TOKEN=          # from the DuckDNS dashboard

# --- optional: budgets (defaults already sit under Groq's free plan for gpt-oss-20b) ---
# LLM_DAILY_TOKEN_BUDGET=180000
# LLM_SESSION_DAILY_TOKEN_BUDGET=50000

APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cat_rag
EMBEDDING_MODEL=all-MiniLM-L6-v2

POSTGRES_URL=postgresql+psycopg://cat_rag:cat_rag@localhost:5432/cat_rag

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_SESSION_URL=redis://localhost:6379/1

# Required by docker-compose.yml
POSTGRES_PASSWORD=change-me
METRICS_TOKEN=change-me-long-random-string

# Optional local fallback (see the ollama profile in docker-compose.yml)
LLM_ENABLED_PROVIDERS=groq
LLM_FALLBACK_PROVIDERS=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# --- Token budgets (the app stops calling the LLM when one is used up) ---
# Usage is counted from the tokens the provider reports, so these are real tokens. One question is roughly 1.5-2.5k tokens.
# Groq free plan for openai/gpt-oss-20b (check your console, it is authoritative): 30 requests/min, 1K requests/day,
# 8K tokens/min, 200K tokens/day, shared by your whole organization. The defaults below stay just under that:
# LLM_PROVIDER_DAILY_TOKEN_BUDGET=190000  # hard stop per provider per UTC day
# LLM_DAILY_TOKEN_BUDGET=180000           # all visitors together, per UTC day
# LLM_ROLLING_TOKEN_BUDGET=100000         # all visitors together, per rolling window (default window: 1 hour)
# LLM_SESSION_DAILY_TOKEN_BUDGET=50000    # one visitor per day (about 25 questions)
# LLM_SESSION_ROLLING_TOKEN_BUDGET=30000  # one visitor per window (about 15 questions per hour)
# On another model or plan, set the first two just below its daily token limit and scale the others to taste.

# --- Answering behaviour ---
# GENERAL_ANSWERS_ENABLED=true    # off-topic questions get a general answer (response "mode" = "general") instead of a refusal
# MIN_RELEVANCE_SCORE=0.5         # reranker score below which a question counts as off-topic
# PROMPT_HISTORY_MESSAGES=6       # recent messages sent to the model (smaller prompts, fewer tokens)
# MAX_CONTEXT_CHARS=6000
# SHARED_ANSWER_CACHE_ENABLED=true  # first questions about public portfolio content are answered once for all visitors

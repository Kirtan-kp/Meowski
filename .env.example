APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=groq
LLM_API_KEY=
# Provider resilience: fallback providers are NEVER enabled automatically.
LLM_ENABLED_PROVIDERS=groq
LLM_FALLBACK_PROVIDERS=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_PROVIDER_FAILURE_THRESHOLD=3
LLM_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

# Security / abuse limits
SESSION_RATE_LIMIT_REQUESTS=20
SESSION_RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_PAGES=50
MAX_UPLOAD_TEXT_CHARS=200000
PARSER_TIMEOUT_SECONDS=15
PARSER_CONCURRENCY_LIMIT=2
METRICS_TOKEN=